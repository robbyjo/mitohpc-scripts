#!/usr/bin/env bash
set -Eeuo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
printf 'This Grid Engine entry point is deprecated; submitting through the SLURM launcher.\n' >&2
if (($# < 2)); then
    printf 'Usage: qrun_mhpc_copyme.qsub INPUT_DIR OUTPUT_DIR [options]\n' >&2
    exit 2
fi
exec "$HERE/mito_pipeline.sh" "$@"
